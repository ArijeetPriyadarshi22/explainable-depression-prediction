    classDef server fill:#DBEAFE,stroke:#1D4ED8,color:#0F172A,rx:8,ry:8;
    classDef tool fill:#ECFDF5,stroke:#047857,color:#0F172A,rx:8,ry:8;
    classDef prompt fill:#F5F3FF,stroke:#7C3AED,color:#111827,rx:8,ry:8;
    classDef generator fill:#FFF7ED,stroke:#C2410C,color:#0F172A,rx:8,ry:8;
    classDef llm fill:#FEF3C7,stroke:#B45309,color:#0F172A,rx:8,ry:8;
    classDef data fill:#F1F5F9,stroke:#475569,color:#0F172A,rx:8,ry:8;
    classDef output fill:#F0FDFA,stroke:#0F766E,color:#0F172A,rx:8,ry:8;
